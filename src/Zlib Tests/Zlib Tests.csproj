<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<RootNamespace>Ionic.Zlib.Tests</RootNamespace>
		<AssemblyName>ZlibTest</AssemblyName>
		<TargetFramework>net48</TargetFramework>
		<ProjectTypeGuids>{3AC096D0-A1C2-E12C-1390-A8335801FDAB};{FAE04EC0-301F-11D3-BF4B-00C04F79EFBC}</ProjectTypeGuids>
		<AssemblyTitle>ZlibTest</AssemblyTitle>
		<Description>test modules for Ionic's ZLIB</Description>
	</PropertyGroup>
	<ItemGroup>
		<Content Include="Resources\zlibbed.file">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
		<PackageReference Include="xunit" Version="2.9.2" />
		<PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
		<PackageReference Include="coverlet.collector" Version="6.0.2" />
		<PackageReference Include="Xunit.SkippableFact" Version="1.4.13" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\Zlib\Zlib DLL.csproj" />
		<ProjectReference Include="..\Tools\GZip\GZip.csproj" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\TestCommon\Ionic.TestCommon.csproj" />
	</ItemGroup>
	<ItemGroup>
		<!-- assembly-level attributes have to be compiled into each test assembly -->
		<Compile Include="..\TestCommon\TestAssemblyInfo.cs" Link="TestCommon\TestAssemblyInfo.cs" />
		<!-- runner settings; see the file for why shadow copying is off -->
		<Content Include="..\TestCommon\xunit.runner.json" Link="xunit.runner.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>
</Project>