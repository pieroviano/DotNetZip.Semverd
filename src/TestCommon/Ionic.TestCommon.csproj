<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<RootNamespace>Ionic.Tests</RootNamespace>
		<AssemblyName>Ionic.TestCommon</AssemblyName>
		<TargetFramework>net48</TargetFramework>
		<AssemblyTitle>Ionic.TestCommon</AssemblyTitle>
		<Description>xUnit infrastructure shared by the DotNetZip test projects</Description>
		<IsPackable>false</IsPackable>
		<Version>1.0.0.0</Version>
	</PropertyGroup>
	<ItemGroup>
		<!--
		  TestAssemblyInfo.cs carries assembly-level attributes, so it has to be
		  compiled into each test assembly rather than into this shared one. The
		  test projects link it directly.
		-->
		<Compile Remove="TestAssemblyInfo.cs" />
		<None Include="TestAssemblyInfo.cs" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="xunit" Version="2.9.2" />
		<PackageReference Include="Xunit.SkippableFact" Version="1.4.13" />
	</ItemGroup>
</Project>
