<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net48</TargetFramework>
		<LangVersion>latest</LangVersion>
		<AssemblyName>UnitTestProgressMonitor</AssemblyName>
		<RootNamespace>UnitTestProgressMonitor</RootNamespace>
		<AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>

		<!-- assembly metadata, formerly Properties\AssemblyInfo.cs -->
		<AssemblyTitle>UnitTestProgressMonitor</AssemblyTitle>
		<Company>MSIT</Company>
		<Product>UnitTestProgressMonitor</Product>
		<Copyright>Copyright © MSIT 2009</Copyright>
		<Version>1.0.0.0</Version>
	</PropertyGroup>

	<ItemGroup>
		<Reference Include="System.Windows.Forms" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Ionic.CopyData\Ionic.CopyData.csproj" />
	</ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>